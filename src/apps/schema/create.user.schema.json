{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "CreateUserSchema",
  "type": "object",

  "properties": {
    "name": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": ["admin", "customer"]
    }
  },
  "required": ["name", "user_name", "email", "password", "role"]
}
