{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "CreateBookSchema",
  "type": "object",
  "properties": {
    "isbn": {
      "type": "string",
      "pattern": "^[0-9]{13}$"
    },
    "price": {
      "type": "number",
      "multipleOf": 0.01,
      "minimum": 0,
      "maximum": 9999.99
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": ["isbn", "price", "stock"]
}
