{
  "$schema": "https://json-schema.org/draft/2020-12/schema#",
  "title": "CreateBookSchema",
  "type": "object",

  "properties": {
    "name": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "detail": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "multipleOf": 0.01,
      "minimum": 0,
      "maximum": 9999.99
    },
    "stock": {
      "type": "integer"
    }
  },
  "required": ["name", "author", "year", "detail", "price", "stock"]
}
